[Unit]
Description=Tutoring API
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=ec2-user
Environment="NODE_ENV=production"
ExecStart=/bin/bash -l -c 'exec "$@"' _ node dist/src/main.js
WorkingDirectory=/home/ec2-user/api

[Install]
WantedBy=multi-user.target
